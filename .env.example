# GROQ_API_KEY: High-speed LPU inference with Llama 3.3 70B, Llama 3.1 8B, Mixtral.
# Free keys can be generated at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NASA_FIRMS_MAP_KEY: API MAP key for NASA FIRMS real-time satellite fire data feeds.
# Free keys can be generated at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY="4ddefd0f9c4e2cf87148595c54a19642"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL="https://zpqjdvomzdnpqxddevqn.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Service role (secret) key from
# Supabase Dashboard > Project Settings > API. Used server-side only to
# persist thermal fire detections to the fire_detections table.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
